generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(cuid())
  playerNumber         Int      @unique @default(autoincrement())
  username             String   @unique
  passwordHash         String
  countryCode          String?
  countryName          String?
  countryFlag          String?
  photoUrl             String?  @db.Text
  background           String   @default("clasico")
  unlockedBackgrounds  Json     @default("[\"clasico\"]") // Fase 5 — Recompensas
  titles               Json     @default("[]") // insignias ganadas, ej. "🏆 Campeón — Copa PES ARENA"
  tournamentsWon       Int      @default(0)
  points               Int      @default(0)
  confiabilidad        Int      @default(100)
  createdAt            DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Módulo Torneos — Fase 1 (núcleo: Copa). "type" ya distingue copa/liga para
// que la Fase 3 (Liga) reutilice estas mismas tablas sin migraciones nuevas.
// ---------------------------------------------------------------------------
model Tournament {
  id              String   @id @default(cuid())
  name            String
  type            String   @default("copa") // copa (fase 1) | liga (fase 3)
  status          String   @default("inscripciones") // inscripciones | grupos | eliminatorias | finalizado
  minPlayers      Int      @default(4)
  maxGroupSize    Int      @default(4)
  advancePerGroup Int      @default(2)
  deadlineHours   Int      @default(72) // plazo por partido — Fase 2, motor de temporadas
  theme           String   @default("dorado") // identidad visual: dorado (Copa) | azul (Liga)
  edition         Int      @default(1) // 1a, 2a, 3a vez que corre este torneo
  teamsBank       Json     @default("[]") // Banco de Equipos EXCLUSIVO de este torneo
  championId      String?
  news            Json     @default("[]") // Noticias del Torneo — eventos publicados automáticamente
  createdAt       DateTime @default(now())
  entries         TournamentEntry[]
  matches         TournamentMatch[]
}

model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  userId       String
  groupName    String?
  team         String? // asignado al azar cuando arranca el torneo
  sorteoSeen   Boolean    @default(false) // ya vio la animación de la ruleta
  joinedAt     DateTime   @default(now())

  @@unique([tournamentId, userId])
}

model TournamentMatch {
  id            String     @id @default(cuid())
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id])
  phase         String // grupos | knockout
  round         String? // "Grupo A", "Octavos", "Cuartos", "Semifinal", "Final"
  playerAId     String
  playerBId     String
  ipA           String?
  ipB           String?
  reportA       Json? // lo que el jugador A dice que fue el marcador
  reportB       Json? // lo que el jugador B dice que fue el marcador
  scoreA        Int?
  scoreB        Int?
  status        String     @default("pendiente") // pendiente | aprobado | conflicto
  messages      Json       @default("[]")
  lastActiveA   DateTime? // Sistema de Evidencias
  lastActiveB   DateTime?
  deadline      DateTime? // Fase 2 — motor de temporadas
  reminderSent  Boolean    @default(false)
  autoResolved  Boolean    @default(false) // true si el sistema lo decidió por inasistencia, no los jugadores
  approvedAt    DateTime?
  createdAt     DateTime   @default(now())
}
